source "https://rubygems.org"

rails_version = ENV["RAILS_VERSION"]
if rails_version && !rails_version.empty?
  gem "rails", "~> #{rails_version}.0"
else
  gem "rails", ">= 7.2", "< 8.1"
end

# ActiveSupport < 8.1 calls JSON.generate with the quirks_mode: keyword json 3.0
# removed, so every to_json raises there.
if rails_version.nil? || rails_version.empty? || Gem::Version.new(rails_version) < Gem::Version.new("8.1")
  gem "json", "< 3"
end

gem "sqlite3", "~> 2.0"
gem "puma", "~> 6.0"
